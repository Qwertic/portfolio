---
import "@fontsource-variable/anybody/wdth.css";
import "@fontsource-variable/schibsted-grotesk";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: canonical.href,
  name: title,
  mainEntity: {
    "@type": "Person",
    "@id": `${Astro.site}#person`,
    name: "Regi Voda",
    alternateName: "Qwertic",
    jobTitle: "AI Engineer, Full Stack",
    description,
    url: Astro.site?.href,
    image: ogImage.href,
    email: "mailto:0xQwertic@proton.me",
    address: { "@type": "PostalAddress", addressCountry: "IT" },
    knowsLanguage: ["it", "sq", "el", "en"],
    knowsAbout: [
      "AI engineering",
      "Large language models",
      "Model Context Protocol (MCP)",
      "Context engineering",
      "Retrieval-augmented generation",
      "AI agents",
      "Full-stack development",
      "TypeScript",
      "React",
      "Next.js",
      "Ruby on Rails",
      "PostgreSQL",
    ],
    sameAs: ["https://github.com/Qwertic", "https://www.linkedin.com/in/regi-voda"],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#F6F4EF" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta name="author" content="Regi Voda" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Qwertic" />
    <meta property="og:locale" content="en_GB" />
    <meta property="profile:first_name" content="Regi" />
    <meta property="profile:last_name" content="Voda" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Qwertic: AI engineer, full stack. Regi Voda." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
