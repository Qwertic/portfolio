---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import { EMAIL, LINKEDIN, GITHUB, CV_PATH, bookingHref, work, stack, experience, tools, statusLabel } from "../data/site";

const hasCv = fs.existsSync(new URL(`../../public${CV_PATH}`, import.meta.url));
const [lead, ...rest] = work;
// Two-ink figures: layer a prints first, layer b is the second pass that slips on hover.
const glyphs: Record<string, { a: string; b: string }> = {
  "Agent memory": {
    a: `<rect x="14" y="70" width="92" height="30" fill="var(--blue)"/>`,
    b: `<circle cx="32" cy="46" r="18" fill="var(--pink)"/><circle cx="60" cy="40" r="18" fill="var(--pink)"/><circle cx="88" cy="46" r="18" fill="var(--pink)"/>`,
  },
  "Core chat module": {
    a: `<path d="M12 18h62v42H34l-14 14V60h-8z" fill="var(--blue)"/>`,
    b: `<path d="M46 44h62v42h-8v14L86 86H46z" fill="var(--pink)"/>`,
  },
  "CRM, from scratch": {
    a: `<rect x="14" y="14" width="92" height="92" fill="var(--blue)"/>`,
    b: `<rect x="26" y="28" width="56" height="12" fill="var(--pink)"/><rect x="26" y="54" width="68" height="12" fill="var(--pink)"/><rect x="26" y="80" width="44" height="12" fill="var(--pink)"/>`,
  },
  "Public API": {
    a: `<rect x="14" y="30" width="56" height="56" fill="var(--blue)"/>`,
    b: `<rect x="50" y="50" width="56" height="56" fill="var(--pink)"/>`,
  },
};
const arrow = `<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 10h12M10.5 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2.4"/></svg>`;
---

<Base
  title="Qwertic: AI engineer, full stack"
  description="Regi Voda (Qwertic) builds LLM features that hold up in production, from the database to the model. Remote from Milan."
>
  <header class="top wrap">
    <a class="mark print-host" href="#top" aria-label="Qwertic, home">
      <svg class="qmark" viewBox="0 0 40 40" aria-hidden="true">
        <circle cx="18" cy="18" r="11.5" fill="none" stroke="var(--pink)" stroke-width="6.5" />
        <rect x="22" y="24" width="14" height="6.5" transform="rotate(40 29 27.25)" fill="var(--blue)" />
      </svg>
      <span class="print print--clean caps mark__word" data-ink="Qwertic">Qwertic</span>
    </a>
    <nav aria-label="Sections">
      <ul class="nav label">
        <li><a href="#work">Work</a></li>
        <li><a href="#stack">Stack</a></li>
        <li><a href="#tools">Tools</a></li>
        <li><a href="#experience">Experience</a></li>
      </ul>
    </nav>
    <a class="btn btn--blue top__cta" href={bookingHref}>Book a call</a>
  </header>

  <main id="top">
    <!-- first viewport -->
    <section class="hero wrap" aria-labelledby="hero-h">
      <div class="hero__main">
        <h1 id="hero-h" class="hero__h caps">
          <span class="print hero__line hero__line--a" data-ink="AI engineer,">AI engineer,</span>
          <span class="print print--pink hero__line hero__line--b" data-ink="full stack.">full stack.</span>
        </h1>
        <p class="hero__lede">
          I'm Regi Voda, known as Qwertic. I build LLM features that hold up in production, from the database to the
          model. Remote from Milan, for teams hiring and for products that need it built.
        </p>
        <div class="hero__actions">
          <a class="btn btn--blue" href={bookingHref}>Book a call <Fragment set:html={arrow} /></a>
          <a class="btn btn--line" href={`mailto:${EMAIL}`}>Email me</a>
        </div>
      </div>

      <aside class="hero__side" aria-label="Now">
        <svg class="figure" viewBox="0 0 320 300" aria-hidden="true">
          <defs>
            <pattern id="dots" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(18)">
              <circle cx="4.5" cy="4.5" r="2.3" fill="var(--blue)" />
            </pattern>
          </defs>
          <g class="figure__ink">
            <circle class="f-ring" cx="150" cy="140" r="96" fill="none" stroke="var(--pink)" stroke-width="54" />
            <rect class="f-tail" x="176" y="196" width="140" height="52" transform="rotate(38 246 222)" fill="var(--blue)" />
            <circle class="f-dots" cx="96" cy="86" r="62" fill="url(#dots)" />
          </g>
        </svg>
        <div class="now">
          <p class="now__t">Right now I'm building an AI assistant for an EdTech credentialing platform.</p>
          <p class="now__d">Documents in, structured data out, a human approves before it counts.</p>
          <a class="now__link" href="#work">See the work</a>
        </div>
      </aside>
    </section>

    <!-- work -->
    <section class="section wrap" id="work" aria-labelledby="work-h">
      <div class="section__head">
        <h2 id="work-h" class="caps section__h"><span class="print" data-ink="Selected work">Selected work</span></h2>
        <p class="section__lede">What's live, what's in progress, and what I shipped at scale.</p>
      </div>

      <article class="lead print-host">
        <div class="lead__text">
          <h3 class="caps lead__h"><span class="print print--light" data-ink={lead.title}>{lead.title}</span></h3>
          <p class="meta label">
            <span class={`status status--${lead.status}`}>{statusLabel[lead.status]}</span>
            <span>{lead.context}</span><span>{lead.when}</span>
          </p>
          <p class="lead__sum">{lead.summary}</p>
          <ul class="facts">{lead.facts.map((f) => <li>{f}</li>)}</ul>
          <p class="layers label">{lead.layers.join(" / ")}</p>
        </div>
        <figure class="flow" aria-label="How it works: upload, extract, review">
          <ol>
            <li class="flow__step">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <g class="ink-a"><rect x="26" y="14" width="68" height="92" fill="var(--blue)" /></g>
                <g class="ink-b"><rect x="38" y="34" width="44" height="8" fill="var(--pink)" /><rect x="38" y="52" width="34" height="8" fill="var(--pink)" /><rect x="38" y="70" width="40" height="8" fill="var(--pink)" /></g>
              </svg>
              <span class="label">Upload</span>
              <span class="flow__d">PDF, DOCX, XML</span>
            </li>
            <li class="flow__step">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <g class="ink-a"><circle cx="60" cy="60" r="44" fill="var(--pink)" /></g>
                <g class="ink-b"><rect x="30" y="40" width="30" height="10" fill="var(--blue)" /><rect x="30" y="58" width="48" height="10" fill="var(--blue)" /><rect x="30" y="76" width="22" height="10" fill="var(--blue)" /></g>
              </svg>
              <span class="label">Extract</span>
              <span class="flow__d">LLM to structured data</span>
            </li>
            <li class="flow__step">
              <svg viewBox="0 0 120 120" aria-hidden="true">
                <g class="ink-a"><rect x="16" y="16" width="88" height="88" fill="none" stroke="var(--blue)" stroke-width="12" /></g>
                <g class="ink-b"><path d="M34 62 52 80 88 40" fill="none" stroke="var(--pink)" stroke-width="14" /></g>
              </svg>
              <span class="label">Review</span>
              <span class="flow__d">A person approves it</span>
            </li>
          </ol>
        </figure>
      </article>

      <ul class="rows">
        {
          rest.map((w) => (
            <li class="row print-host">
              <svg class="glyph" viewBox="0 0 120 120" aria-hidden="true">
                <g class="ink-a"><Fragment set:html={glyphs[w.title].a} /></g>
                <g class="ink-b"><Fragment set:html={glyphs[w.title].b} /></g>
              </svg>
              <h3 class="caps row__h">
                <span class="print print--light" data-ink={w.title}>{w.title}</span>
              </h3>
              <p class="meta label">
                <span class={`status status--${w.status}`}>{statusLabel[w.status]}</span>
                <span>{w.context}</span>
                <span>{w.when}</span>
              </p>
              <p class="row__sum">{w.summary}</p>
              <ul class="facts facts--small">
                {w.facts.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
              <p class="layers label">{w.layers.join(" / ")}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- stack -->
    <section class="section wrap" id="stack" aria-labelledby="stack-h">
      <div class="section__head">
        <h2 id="stack-h" class="caps section__h"><span class="print print--pink" data-ink="Across the stack">Across the stack</span></h2>
        <p class="section__lede">One person from the migration to the model call to the screen, tested on the way.</p>
      </div>
      <div class="stack">
        {
          stack.map((s) => (
            <div class="stack__col">
              <h3 class="caps stack__h">{s.name}</h3>
              <ul>
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <!-- tools -->
    <section class="section section--ink" id="tools" aria-labelledby="tools-h"><div class="wrap">
      <div class="section__head">
        <h2 id="tools-h" class="caps section__h"><span class="print print--on-ink" data-ink="Tools I build">Tools I build</span></h2>
        <p class="section__lede">Agent tooling I make for my own work and use every day. Some of it other developers use too.</p>
      </div>
      <ul class="tools">
        {
          tools.map((t) => (
            <li class="tool print-host">
              <h3 class="caps tool__h">
                <span class="print print--on-ink print--clean" data-ink={t.name}>{t.name}</span>
              </h3>
              <p class="tool__what">{t.what}</p>
              <p class="label tool__meta">{t.meta}</p>
              {t.href && (
                <a class="tool__link label" href={t.href} rel="noopener">
                  <span class="visually-hidden">{t.name} on </span>GitHub <Fragment set:html={arrow} />
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div></section>

    <!-- experience -->
    <section class="section wrap" id="experience" aria-labelledby="exp-h">
      <div class="section__head">
        <h2 id="exp-h" class="caps section__h"><span class="print print--pink" data-ink="Experience">Experience</span></h2>
        <p class="section__lede">
          Italian and Albanian native, fluent Greek, professional English. Le Wagon bootcamp 2019, ThePower MBA (online
          program, certificate) 2020.
        </p>
      </div>
      <ol class="exp">
        {
          experience.map((e) => (
            <li>
              <span class="label exp__when">{e.when}</span>
              <span class="caps exp__where">{e.where}</span>
              <span class="exp__what">{e.what}</span>
            </li>
          ))
        }
      </ol>
      {
        hasCv && (
          <a class="btn btn--line exp__cv" href={CV_PATH} download>
            Download CV (PDF)
          </a>
        )
      }
    </section>
  </main>

  <!-- contact -->
  <footer class="contact" id="contact" aria-labelledby="contact-h">
    <div class="wrap contact__in">
      <h2 id="contact-h" class="caps contact__h">
        <span class="print contact__print" data-ink="Work with me">Work with me</span>
      </h2>
      <div class="doors">
        <div class="door">
          <h3 class="caps door__h">You're hiring</h3>
          <p>AI engineering or full-stack roles, permanent welcome. Remote-first, or hybrid in Milan.</p>
        </div>
        <div class="door">
          <h3 class="caps door__h">You need it built</h3>
          <p>An LLM feature that has to work in production, built end to end: data, API, UI and the model in between.</p>
        </div>
      </div>
      <div class="contact__actions">
        <a class="btn btn--ink" href={bookingHref}>Book a call <Fragment set:html={arrow} /></a>
        <a class="contact__link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="contact__link" href={LINKEDIN} rel="noopener">LinkedIn</a>
        <a class="contact__link" href={GITHUB} rel="noopener">GitHub</a>
      </div>
      <p class="contact__foot label">
        <span>Qwertic is Regi Voda. Milan, Italy.</span><span>&copy; {new Date().getFullYear()}</span>
      </p>
    </div>
  </footer>
</Base>

<style>
  /* ---------- top bar ---------- */
  .top {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 1.1rem;
    border-bottom: 1.5px solid var(--rule);
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--blue);
  }

  .qmark {
    width: 2.1rem;
    height: 2.1rem;
    -webkit-mask: url("/grain.svg");
    mask: url("/grain.svg");
  }

  .qmark rect {
    mix-blend-mode: multiply;
  }

  .mark__word {
    font-size: 1.9rem;
    line-height: 1;
  }

  .top nav {
    margin-left: auto;
  }

  .nav {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2rem);
  }

  .nav a {
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--blue);
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--pink);
  }

  .top__cta {
    min-height: 2.6rem;
    padding: 0.55rem 1rem 0.5rem;
    font-size: 0.9rem;
  }

  /* ---------- first viewport ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
  }

  .hero__main {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem) clamp(2rem, 5vw, 4rem) 0;
    border-right: 1.5px solid var(--rule);
  }

  .hero__h {
    display: flex;
    flex-direction: column;
    font-size: clamp(4.2rem, 14vw, 13.25rem);
    line-height: 0.86;
    letter-spacing: -0.005em;
  }

  .hero__line {
    width: fit-content;
  }

  /* one overprint: a blue halftone disc laid over the second line, purple where it hits pink */
  .hero__main::after {
    content: "";
    position: absolute;
    top: clamp(6rem, 17vw, 15rem);
    right: clamp(-2rem, 2vw, 3rem);
    width: clamp(8rem, 20vw, 17rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, var(--blue) 2.4px, transparent 2.8px) 0 0 / 10px 10px;
    mix-blend-mode: multiply;
    opacity: 0.8;
    pointer-events: none;
    -webkit-mask: radial-gradient(closest-side, #000 96%, transparent 100%);
    mask: radial-gradient(closest-side, #000 96%, transparent 100%);
  }

  /* the headline prints in two passes: blue is already down, the second ink lands */
  .hero__line::after {
    animation: second-pass 900ms var(--ease-out) 250ms both;
  }

  .hero__line--b::after {
    animation-delay: 420ms;
  }

  @keyframes second-pass {
    from {
      opacity: 0;
      translate: 18px -12px;
    }
  }

  .hero__lede {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    max-width: 38ch;
    font-size: clamp(1.15rem, 1.7vw, 1.38rem);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem 1.1rem;
    margin-top: 2rem;
  }

  .hero__side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(2rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .figure {
    width: 100%;
    max-width: 22rem;
    align-self: center;
    overflow: visible;
  }

  .figure__ink {
    -webkit-mask: url("/grain.svg");
    mask: url("/grain.svg");
  }

  .figure__ink > * {
    mix-blend-mode: multiply;
    transition: translate 700ms var(--ease-out);
  }

  .f-tail {
    animation: tail-in 1s var(--ease-out) 300ms both;
  }

  .f-dots {
    translate: 4px 3px;
  }

  @keyframes tail-in {
    from {
      translate: 26px 22px;
      opacity: 0;
    }
  }

  .hero__side:hover .f-ring {
    translate: -5px 3px;
  }
  .hero__side:hover .f-tail {
    translate: 6px 4px;
  }
  .hero__side:hover .f-dots {
    translate: 10px -4px;
  }

  .now {
    padding-top: 1.1rem;
    border-top: 1.5px solid var(--rule);
  }

  .now__t {
    margin-top: 0.2rem;
    font-family: var(--display);
    font-variation-settings: "wdth" 75;
    font-weight: 700;
    font-size: 1.45rem;
    line-height: 1.12;
  }

  .now__d {
    margin-top: 0.5rem;
    color: var(--ink-soft);
  }

  .now__link {
    display: inline-block;
    margin-top: 0.8rem;
    font-weight: 600;
    color: var(--blue);
  }

  /* ---------- sections ---------- */
  .section {
    padding-block: clamp(4.5rem, 9vw, 7.5rem) 0;
  }

  #work {
    padding-top: clamp(2rem, 4vw, 3.25rem);
  }

  .section__head {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    align-items: end;
    gap: 1rem 2.5rem;
    padding-bottom: 1.4rem;
    border-bottom: 1.5px solid var(--rule);
  }

  .section__h {
    font-size: clamp(3rem, 7vw, 6rem);
  }

  .section__lede {
    max-width: 36ch;
    color: var(--ink-soft);
    font-size: 1.08rem;
  }

  .meta {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1rem;
    color: var(--ink-soft);
  }

  .status {
    padding: 0.18rem 0.5rem 0.12rem;
    border: 2px solid currentColor;
  }

  .status--live {
    color: var(--paper);
    background: var(--blue);
    border-color: var(--blue);
  }

  .status--progress {
    color: var(--blue);
    border-style: dashed;
  }

  .status--shipped {
    color: var(--ink);
  }

  .facts {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .facts li {
    position: relative;
    padding-left: 1.3rem;
  }

  .facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 0.62rem;
    height: 0.62rem;
    background: var(--pink);
  }

  .facts--small {
    font-size: 0.98rem;
  }

  .layers {
    margin-top: 1.2rem;
    color: var(--blue);
  }

  /* lead project */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    border-bottom: 1.5px solid var(--rule);
  }

  .lead__text {
    padding: clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem) 0;
    border-right: 1.5px solid var(--rule);
  }

  .lead__h {
    margin-top: 0;
    font-size: clamp(3.4rem, 7.5vw, 6rem);
  }

  .lead__sum {
    margin-top: 1rem;
    max-width: 40ch;
    font-size: 1.2rem;
  }

  .flow {
    margin: 0;
    display: flex;
    align-items: center;
    padding: clamp(2rem, 4vw, 3rem) 0 clamp(2rem, 4vw, 3rem) clamp(1.5rem, 4vw, 3rem);
  }

  .flow ol {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    counter-reset: step;
  }

  .flow__step {
    position: relative;
    display: grid;
    gap: 0.3rem;
    justify-items: start;
  }

  .flow__step svg {
    width: 100%;
    max-width: 8.5rem;
    -webkit-mask: url("/grain.svg");
    mask: url("/grain.svg");
  }

  .flow__step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 32%;
    right: -0.9rem;
    width: 0.9rem;
    height: 3px;
    background: var(--ink);
  }

  /* ink shift: only the second pass slips out of register */
  .ink-b {
    mix-blend-mode: multiply;
    translate: 2px 1.5px;
    transition: translate 420ms var(--ease-out);
  }

  .lead:hover .flow__step .ink-b,
  .row:hover .ink-b {
    translate: 7px -5px;
  }

  .flow__step .label {
    margin-top: 0.6rem;
    color: var(--blue);
  }

  .flow__d {
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.35;
  }

  /* other work */
  .rows {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .row {
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.5rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1.5px solid var(--rule);
  }

  .row:nth-child(even) {
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    padding-right: 0;
    border-left: 1.5px solid var(--rule);
  }

  .row {
    position: relative;
  }

  .glyph {
    float: right;
    width: clamp(4rem, 7vw, 5.5rem);
    height: auto;
    margin: 0 0 0.75rem 1.25rem;
    overflow: visible;
    -webkit-mask: url("/grain.svg");
    mask: url("/grain.svg");
  }

  .row__h {
    margin-top: 0.2rem;
    font-size: clamp(2.4rem, 4.2vw, 3.6rem);
  }

  .row__sum {
    margin-top: 0.7rem;
    font-size: 1.1rem;
  }

  /* stack */
  .stack {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 1.5px solid var(--rule);
  }

  .stack__col {
    padding: 1.75rem 1.25rem 2rem;
    border-left: 1.5px solid var(--rule);
  }

  .stack__col:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .stack__h {
    font-size: 2.1rem;
    color: var(--blue);
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    /* halftone underline */
