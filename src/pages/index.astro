---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import Explorer from "../components/Explorer.astro";
import Decisions from "../components/Decisions.astro";
import Work from "../components/Work.astro";
import Story from "../components/Story.astro";
import Depth from "../components/Depth.astro";
import { EMAIL, LINKEDIN, GITHUB, CV_PATH, bookingHref } from "../data/site";

const hasCv = fs.existsSync(`${process.cwd()}/public${CV_PATH}`);
---

<Base
  title="Regi Voda (Qwertic): AI Lead, Full Stack"
  description="Regi Voda (Qwertic) is an AI lead across the full stack: knowing what to build with AI, how, and when not to. Memory, MCP, retrieval, guardrails and evaluation, from the database to the model. Remote from Italy."
>
  <a class="skip" href="#main">Skip to content</a>
  <header class="top col">
    <a class="top__name" href="#main">Qwertic</a>
    <nav aria-label="Sections">
      <ul>
        <li><a href="#explorer">Should this use AI?</a></li>
        <li><a href="#decisions">Where AI belongs</a></li>
        <li><a href="#work">Work</a></li>
        <li><a href="#story">How I got here</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <main id="main">
    <section class="intro col" aria-labelledby="intro-h">
      <p class="intro__who">Regi Voda, known as Qwertic. Italy, remote.</p>
      <h1 id="intro-h">AI lead across the full stack.</h1>
      <p class="intro__lede">
        Knowing what to build with AI, how, and when not to. I take AI features from first experiment to production,
        from the database to the model, and help teams make those calls well.
      </p>
      <p class="actions">
        <a class="btn" href={bookingHref}>Book a call</a>
        <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </p>
    </section>

    <Explorer />
    <Decisions />
    <Work />
    <Story />

    <section class="contact col ruled" id="contact" aria-labelledby="contact-h">
      <h2 id="contact-h">Contact</h2>
      <div class="doors">
        <div>
          <h3>Hiring an AI lead</h3>
          <p>I'm open to AI lead and senior AI engineering roles. Remote from Italy, or hybrid from Milan.</p>
        </div>
        <div>
          <h3>Building an AI feature</h3>
          <p>Tell me what you want to build. The first call is about whether it should use AI at all.</p>
        </div>
      </div>
      <p class="actions">
        <a class="btn" href={bookingHref}>Book a call</a>
        <a class="link" href={`mailto:${EMAIL}`}>Email</a>
        <a class="link" href={LINKEDIN} rel="noopener">LinkedIn</a>
        <a class="link" href={GITHUB} rel="noopener">GitHub</a>
        {hasCv && <a class="link" href={CV_PATH} download>CV (PDF)</a>}
      </p>
    </section>
  </main>

  <Depth />

  <footer class="foot col">
    <p>Palette follows the season<span data-season-now></span>.</p>
    <p><button class="link foot__theme" type="button" data-theme-toggle hidden>Dark theme</button></p>
    <p>Qwertic, Regi Voda</p>
  </footer>
</Base>

<script>
  // Footer: name the season, and let the visitor override the OS theme. The choice is a convenience, kept locally.
  const root = document.documentElement;
  const season = document.querySelector("[data-season-now]");
  if (season) season.textContent = `, ${root.dataset.season ?? "autumn"} now`;

  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");
  const osDark = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : osDark.matches);
  const label = () => {
    if (toggle) toggle.textContent = isDark() ? "Light theme" : "Dark theme";
  };
  if (toggle) {
    toggle.hidden = false;
    label();
    toggle.addEventListener("click", () => {
      const next = isDark() ? "light" : "dark";
      root.dataset.theme = next;
      try {
        localStorage.setItem("theme", next);
      } catch {}
      label();
    });
    osDark.addEventListener("change", label);
  }
</script>

<style>
  .top {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-top: var(--s-4);
  }

  .top__name {
    font-weight: 700;
    text-decoration: none;
  }

  .top nav {
    margin-left: auto;
  }

  .top ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--s-3);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }

  .top nav a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: color var(--t-hover) var(--ease), text-decoration-color var(--t-hover) var(--ease);
  }

  .top nav a:hover {
    color: var(--ink);
    text-decoration-color: var(--hair);
  }

  .intro {
    padding-block: var(--s-7) var(--s-6);
  }

  .intro__who {
    color: var(--ink-2);
  }

  h1 {
    margin-top: var(--s-2);
    font-size: var(--fs-5);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .intro__lede {
    margin-top: var(--s-3);
    max-width: var(--measure);
    font-size: var(--fs-3);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .actions {
    margin-top: var(--s-4);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
  }

  .contact {
    padding-block: var(--s-6) var(--s-7);
  }

  h2 {
    font-size: var(--fs-4);
    font-weight: 500;
    line-height: 1.25;
  }

  .doors {
    margin-top: var(--s-4);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
  }

  h3 {
    font-size: var(--fs-3);
    font-weight: 500;
    line-height: 1.3;
  }

  .doors p {
    margin-top: var(--s-1);
    color: var(--ink-2);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    padding-block: var(--s-3) var(--s-4);
    border-top: 1px solid var(--hair);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }

  .foot__theme {
    border: 0;
    padding: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    cursor: pointer;
  }

  .foot__theme[hidden] {
    display: none;
  }

  @media (max-width: 40rem) {
    .top {
      flex-direction: column;
      gap: var(--s-1);
    }

    .top nav {
      margin-left: 0;
    }

    .intro {
      padding-top: var(--s-6);
    }

    .doors {
      grid-template-columns: 1fr;
      gap: var(--s-3);
    }
  }
</style>
