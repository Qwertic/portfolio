---
import fs from "node:fs";
import Base from "../layouts/Base.astro";
import {
  EMAIL,
  LINKEDIN,
  GITHUB,
  CV_PATH,
  bookingHref,
  tickets,
  stations,
  record,
  tools,
  statusLabel,
  statusNote,
} from "../data/site";

const hasCv = fs.existsSync(new URL(`../../public${CV_PATH}`, import.meta.url));
const stationKey: Record<string, string> = { Database: "DB", API: "API", Frontend: "UI", LLM: "LLM", Tooling: "Tooling" };
const firstId = tickets[0].id;
---

<Base
  title="Qwertic: AI engineer, full stack"
  description="Regi Voda (Qwertic) builds LLM features that hold up in production, from the database to the model. Remote from Milan."
>
  <header class="rail-zone">
    <nav class="bar wrap" aria-label="Sections">
      <a class="bar__mark" href="#top">Qwertic</a>
      <ul class="bar__links">
        <li><a href="#line">The line</a></li>
        <li><a href="#spike">Record</a></li>
        <li><a href="#mise">Tools</a></li>
        <li><a href="#order">Contact</a></li>
      </ul>
    </nav>

    <div class="rail" id="top">
      <div class="rail__bar" aria-hidden="true"></div>
      <div class="rail__track" role="tablist" aria-label="Work on the rail">
        {
          tickets.map((t, i) => (
            <button
              class={`slip slip--${t.status}`}
              role="tab"
              id={`tab-${t.id}`}
              aria-controls={`panel-${t.id}`}
              aria-selected={t.id === firstId ? "true" : "false"}
              tabindex={t.id === firstId ? 0 : -1}
              data-ticket={t.id}
              style={`--i:${i}`}
            >
              <span class="slip__clip" aria-hidden="true" />
              <span class="slip__paper">
                <span class="slip__top">
                  <span>#{t.no}</span>
                  <span class={`stamp stamp--${t.status}`}>{statusLabel[t.status]}</span>
                </span>
                <span class="slip__title">{t.title}</span>
                <span class="slip__table">{t.table}</span>
                <span class="slip__stations">{t.stations.join(" / ")}</span>
              </span>
            </button>
          ))
        }
      </div>
    </div>
  </header>

  <main>
    <section class="pass wrap" aria-labelledby="who">
      <div class="pass__copy">
        <h1 id="who" class="plate">
          <span class="plate__word">Qwertic</span>
        </h1>
        <p class="pass__role">AI engineer, full stack.</p>
        <p class="pass__lede">
          I build LLM features that hold up in production, from the database to the model. For teams hiring and for
          products that need it built.
        </p>
        <div class="pass__actions">
          <a class="btn btn--lamp" href={bookingHref}>
            Book a call
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
          </a>
          <a class="btn btn--line" href={`mailto:${EMAIL}`}>Email me</a>
        </div>
        <p class="pass__who">Regi Voda. Remote from Milan, Italy.</p>
      </div>

      <div class="pass__order">
        {
          tickets.map((t) => (
            <article
              class={`order order--${t.status}`}
              role="tabpanel"
              id={`panel-${t.id}`}
              aria-labelledby={`tab-${t.id}`}
              hidden={t.id !== firstId}
              tabindex="0"
            >
              <div class="order__head">
                <span>Order #{t.no}</span>
                <span>{t.when}</span>
              </div>
              <div class="order__table">Table: {t.table}</div>
              <h2 class="order__title">{t.title}</h2>
              <ul class="order__lines">
                {t.lines.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              <div class="order__foot">
                <span>Stations: {t.stations.join(" / ")}</span>
                <span class={`stamp stamp--big stamp--${t.status}`}>
                  {statusLabel[t.status]}
                  <small>{statusNote[t.status]}</small>
                </span>
              </div>
            </article>
          ))
        }
        <p class="pass__hint">Pull another ticket off the rail.</p>
      </div>
    </section>

    <section class="line" id="line" aria-labelledby="line-h">
      <div class="wrap">
        <h2 id="line-h" class="tape">The line</h2>
        <p class="section-lede">
          One person across every station. I take a feature from the migration to the model call to the screen, and
          test it on the way.
        </p>
      </div>
      <div class="counter wrap">
        {
          stations.map((s) => {
            const key = stationKey[s.name];
            const onRail = tickets.filter((t) => t.stations.includes(key));
            return (
              <div class="station">
                <h3 class="station__name">{s.name}</h3>
                <ul class="station__items">
                  {s.items.map((it) => (
                    <li>{it}</li>
                  ))}
                </ul>
                {onRail.length > 0 && (
                  <p class="station__rail">
                    <span>On the rail:</span>
                    {onRail.map((t) => (
                      <a href="#top" data-pull={t.id}>
                        {t.title}
                      </a>
                    ))}
                  </p>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="spike-zone wrap" id="spike" aria-labelledby="spike-h">
      <div class="spike-zone__intro">
        <h2 id="spike-h" class="tape">On the spike</h2>
        <p class="section-lede">
          Served tickets go on the spike. This is mine, newest on top.
        </p>
      </div>
      <div class="spike">
        <svg class="spike__pin" viewBox="0 0 40 120" aria-hidden="true">
          <defs>
            <linearGradient id="pin" x1="0" x2="1">
              <stop offset="0" stop-color="#7c858b" />
              <stop offset="0.45" stop-color="#eef0f1" />
              <stop offset="1" stop-color="#4a5257" />
            </linearGradient>
          </defs>
          <path d="M20 2 L23 60 L23 104 L17 104 L17 60 Z" fill="url(#pin)" />
          <ellipse cx="20" cy="108" rx="18" ry="6" fill="#4a5257" />
          <ellipse cx="20" cy="105" rx="18" ry="6" fill="#b7bec3" />
        </svg>
        <div class="receipt">
          <div class="receipt__head">
            <span>Qwertic</span>
            <span>Service record</span>
          </div>
          <ol class="receipt__lines">
            {
              record.map((r) => (
                <li>
                  <span class="receipt__when">{r.when}</span>
                  <span class="receipt__where">{r.where}</span>
                  <span class="receipt__what">{r.what}</span>
                </li>
              ))
            }
          </ol>
          <div class="receipt__extra">
            <p><span>Training</span> Le Wagon full-stack bootcamp, 2019. ThePower MBA, online program, certificate, 2020.</p>
            <p><span>Languages</span> Italian and Albanian native, fluent Greek, professional English.</p>
          </div>
          {
            hasCv && (
              <a class="receipt__cv" href={CV_PATH} download>
                Download the full CV (PDF)
              </a>
            )
          }
        </div>
      </div>
    </section>

    <section class="mise" id="mise" aria-labelledby="mise-h">
      <div class="wrap">
        <h2 id="mise-h" class="tape">Mise en place</h2>
        <p class="section-lede">
          The tools I build for my own station and use every day. Some of them other developers use too.
        </p>
        <ul class="shelf">
          {
            tools.map((t) => (
              <li class="tub">
                <span class="tub__label">{t.name}</span>
                <p class="tub__what">{t.what}</p>
                <p class="tub__meta">{t.meta}</p>
                {t.href && (
                  <a class="tub__link" href={t.href} rel="noopener">
                    <span class="visually-hidden">{t.name} on </span>GitHub
                    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M6 14 14 6M7 6h7v7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="order-in wrap" id="order" aria-labelledby="order-h">
      <h2 id="order-h" class="tape">Order in</h2>
      <div class="tables">
        <article class="order order--open">
          <div class="order__head"><span>Table 1</span><span>Hiring</span></div>
          <h3 class="order__title">You're hiring</h3>
          <ul class="order__lines">
            <li>AI engineering or full-stack roles</li>
            <li>Permanent roles welcome</li>
            <li>Remote-first, or hybrid in Milan</li>
          </ul>
        </article>
        <article class="order order--open">
          <div class="order__head"><span>Table 2</span><span>Project</span></div>
          <h3 class="order__title">You need it built</h3>
          <ul class="order__lines">
            <li>An LLM feature that has to work in production</li>
            <li>Built end to end: data, API, UI and the model in between</li>
            <li>Freelance, remote</li>
          </ul>
        </article>
      </div>
      <div class="order-in__actions">
        <a class="btn btn--lamp" href={bookingHref}>
          Book a call
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        </a>
        <a class="btn btn--line" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <a class="btn btn--line" href={LINKEDIN} rel="noopener">LinkedIn</a>
        <a class="btn btn--line" href={GITHUB} rel="noopener">GitHub</a>
      </div>
    </section>
  </main>

  <footer class="foot wrap">
    <p>Qwertic is Regi Voda, full-stack AI engineer. Milan, Italy.</p>
    <p>&copy; {new Date().getFullYear()}</p>
  </footer>
</Base>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".slip"));

  function pull(id: string, focus = false) {
    tabs.forEach((tab) => {
      const on = tab.dataset.ticket === id;
      tab.setAttribute("aria-selected", String(on));
      tab.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(tab.getAttribute("aria-controls")!);
      if (!panel) return;
      panel.hidden = !on;
      if (on) {
        panel.classList.remove("is-printing");
        void panel.offsetWidth;
        panel.classList.add("is-printing");
      }
      if (on && focus) tab.focus();
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => pull(tab.dataset.ticket!));
    tab.addEventListener("keydown", (e) => {
      const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0;
      if (e.key === "Home" || e.key === "End") {
        e.preventDefault();
        pull(tabs[e.key === "Home" ? 0 : tabs.length - 1].dataset.ticket!, true);
      } else if (step) {
        e.preventDefault();
        pull(tabs[(i + step + tabs.length) % tabs.length].dataset.ticket!, true);
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>("[data-pull]").forEach((a) => {
    a.addEventListener("click", () => pull(a.dataset.pull!));
  });
</script>

<style>
  /* ---------- nav ---------- */
  .rail-zone {
    position: relative;
    padding-top: 0.75rem;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .bar__mark {
    font-family: var(--display);
    font-variation-settings: "wdth" 75;
    font-weight: 900;
    font-size: 1.125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .bar__links {
    display: flex;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
    font-weight: 600;
    font-variation-settings: "wdth" 90;
    font-size: 0.95rem;
  }

  .bar__links a {
    text-decoration: none;
    padding-block: 0.5rem;
  }

  .bar__links a:hover {
    text-decoration: underline;
    text-decoration-color: var(--lamp);
  }

  /* ---------- the rail ---------- */
  .rail {
    position: relative;
    margin-top: 0.75rem;
    padding-top: 1.1rem;
  }

  .rail__bar {
    position: absolute;
    inset: 0.5rem 0 auto;
    height: 1.35rem;
    background: linear-gradient(180deg, #f6f7f8 0%, #b7bec3 35%, #7c858b 60%, #d3d8db 80%, #8d959a 100%);
    box-shadow:
      0 3px 6px rgb(0 0 0 / 0.25),
      inset 0 -1px 0 rgb(0 0 0 / 0.25);
    z-index: 2;
  }

  /* heat lamp: warm light cast down onto tickets that are firing */
  .slip--firing::before {
    content: "";
    position: absolute;
    inset: -1.5rem -2.5rem -2rem;
    background: radial-gradient(closest-side, var(--lamp-glow), transparent);
    filter: blur(6px);
    z-index: -1;
    pointer-events: none;
  }

  .rail__track {
    position: relative;
    z-index: 3;
    display: flex;
    gap: clamp(0.6rem, 1.4vw, 1.1rem);
    padding: 0 var(--gutter) 1.75rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
    scrollbar-color: var(--steel-500) transparent;
  }

  @media (min-width: 76rem) {
    .rail__track {
      justify-content: center;
    }
  }

  .slip {
    all: unset;
    flex: 0 0 clamp(11.5rem, 17vw, 13.75rem);
    position: relative;
    scroll-snap-align: start;
    cursor: pointer;
    filter: drop-shadow(0 7px 7px rgb(0 0 0 / 0.18));
    transform-origin: top center;
    animation: slide-in 700ms var(--ease-out) both;
    animation-delay: calc(var(--i) * 70ms + 120ms);
    transition:
      translate 260ms var(--ease-out),
      rotate 260ms var(--ease-out),
      filter 260ms var(--ease-out),
      opacity 260ms var(--ease-out);
  }

  .slip:nth-child(odd) {
    rotate: -0.6deg;
  }
  .slip:nth-child(even) {
    rotate: 0.5deg;
  }

  .slip:hover {
    translate: 0 4px;
  }

  .slip[aria-selected="true"] {
    translate: 0 12px;
    rotate: 0deg;
    filter: drop-shadow(0 14px 12px rgb(0 0 0 / 0.24));
  }

  .slip[aria-selected="false"] .slip__paper {
    background: #f1f1ee;
  }

  .slip:focus-visible {
    outline: none;
  }

  .slip:focus-visible .slip__paper {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  @keyframes slide-in {
    from {
      translate: 3rem 0;
      opacity: 0;
    }
  }

  .slip__clip {
    position: absolute;
    top: -0.9rem;
    left: 50%;
    width: 2.4rem;
    height: 1.6rem;
    translate: -50% 0;
    background: linear-gradient(180deg, #eef0f1, #7c858b);
    border-radius: 2px 2px 6px 6px;
    box-shadow: 0 2px 2px rgb(0 0 0 / 0.3);
    z-index: 2;
  }

  .slip__paper {
    display: grid;
    gap: 0.3rem;
    padding: 1.1rem 0.95rem 1.4rem;
    min-height: 9.5rem;
    background: var(--paper);
    font-family: var(--ticket);
    font-variation-settings: "wdth" 90;
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--ink-soft);
    --tooth: 10px;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / var(--tooth) 100%;
    transition: background-color 260ms var(--ease-out);
  }

  .slip__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-variant-numeric: tabular-nums;
  }

  .slip__title {
    margin-top: 0.3rem;
    font-family: var(--display);
    font-variation-settings: "wdth" 80;
    font-weight: 800;
    font-size: 1.2rem;
    line-height: 1.05;
    color: var(--ink);
  }

  .slip__table {
    color: var(--ink-soft);
  }

  .slip__stations {
    margin-top: auto;
    padding-top: 0.45rem;
    border-top: 1px dashed var(--steel-300);
    letter-spacing: 0.04em;
  }

  /* status stamps */
  .stamp {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.1rem 0.4rem;
    font-family: var(--ticket);
    font-weight: 700;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1.5px solid currentColor;
  }

  .stamp--firing {
    color: var(--lamp-deep);
  }

  .stamp--prep {
    color: var(--ink);
    border-style: dashed;
  }

  .stamp--served {
    color: var(--steel-700);
  }

  .stamp--big {
    font-size: 0.85rem;
    padding: 0.3rem 0.6rem;
    border-width: 2px;
    rotate: -4deg;
  }

  .stamp--big small {
    font-size: 0.7em;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  /* ---------- the pass (first viewport) ---------- */
  .pass {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(4rem, 8vw, 7rem);
  }

  .plate {
    display: inline-block;
    padding: 0.2rem 0.9rem 0.35rem;
    background: linear-gradient(180deg, #e9ecee, #c3c9cd);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.9),
      inset 0 -2px 0 rgb(0 0 0 / 0.12),
      0 4px 10px rgb(0 0 0 / 0.14);
  }

  .plate__word {
    display: block;
    font-family: var(--display);
    font-variation-settings: "wdth" 72;
    font-weight: 900;
    font-size: clamp(3.6rem, 10vw, 6rem);
    line-height: 0.95;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #5d666c;
    /* debossed: letters pressed into the plate */
    text-shadow:
      0 1px 0 rgb(255 255 255 / 0.85),
      0 -1px 0 rgb(0 0 0 / 0.35);
  }

  .pass__role {
    margin-top: 1.4rem;
    font-family: var(--display);
    font-variation-settings: "wdth" 85;
    font-weight: 800;
    font-size: clamp(1.7rem, 3.4vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .pass__lede {
    margin-top: 0.9rem;
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .pass__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .pass__who {
    margin-top: 1.25rem;
    font-size: 0.95rem;
    color: var(--steel-700);
  }

  .pass__order {
    position: relative;
    padding-top: 0.5rem;
  }

  .pass__hint {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    color: var(--steel-700);
  }

  /* ---------- big printed order ---------- */
  .order {
    position: relative;
    padding: 1.5rem 1.5rem 2.2rem;
    background: var(--paper);
    font-family: var(--ticket);
    font-variation-settings: "wdth" 92;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink);
    --tooth: 14px;
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) 50% / var(--tooth) 100%;
  }

  .pass__order .order {
    filter: none;
  }

  .pass__order {
    filter: drop-shadow(0 16px 18px rgb(0 0 0 / 0.2));
  }

  .order:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: -6px;
  }

  .order.is-printing {
    animation: print 520ms steps(14, end) both;
  }

  @keyframes print {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  .order__head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px dashed var(--ink);
    font-variant-numeric: tabular-nums;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }

  .order__table {
    margin-top: 0.8rem;
    color: var(--ink-soft);
  }

  .order__title {
    margin-top: 0.35rem;
    font-family: var(--display);
    font-variation-settings: "wdth" 80;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .order__lines {
    display: grid;
    gap: 0.5rem;
    margin-top: 1.1rem;
  }

  .order__lines li {
    position: relative;
    padding-left: 1.5rem;
  }

  /* kitchen ticket modifiers are printed with a leading plus */
  .order__lines li::before {
    content: "+";
    position: absolute;
    left: 0.2rem;
    font-weight: 700;
    color: var(--lamp-deep);
  }

  .order__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.4rem;
    padding-top: 0.9rem;
    border-top: 1.5px dashed var(--ink);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  /* ---------- shared section bits ---------- */
  .section-lede {
    margin-top: 1.1rem;
    max-width: 52ch;
    font-size: 1.15rem;
    color: var(--ink-soft);
  }

  /* ---------- the line: stations on a steel counter ---------- */
  .line {
    padding-block: clamp(4rem, 8vw, 6.5rem);
    background: linear-gradient(180deg, rgb(35 40 43 / 0.06), rgb(35 40 43 / 0));
    border-top: 1px solid rgb(255 255 255 / 0.7);
    box-shadow: inset 0 1px 0 rgb(0 0 0 / 0.08);
  }

  .counter {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 2.75rem;
    background: linear-gradient(180deg, var(--steel-50), var(--steel-100));
    border: 1px solid var(--steel-300);
    box-shadow:
      inset 0 1px 0 #fff,
      0 10px 24px -12px rgb(0 0 0 / 0.3);
  }

  .station {
    display: flex;
